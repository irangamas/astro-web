---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Notre Entreprise', href: '#entreprise' },
  { label: 'Services', href: '#services' },
  { label: 'Clients', href: '#clients' },
  { label: 'Équipe', href: '#equipe' },
  { label: 'Multimédia', href: '#multimedia' },
  { label: 'Contact', href: '#contact' },
];

const services = [
  'Élimination de la Saleté',
  'Désinfection en Profondeur',
  'Nettoyage de Tapis',
  'Nettoyage de Meubles',
  'Planchers de Bois',
  'Lavage de Vitres',
  'Nettoyage d\'Entrepôts',
  'Services Spécialisés',
];

const address = '3270 des Quatre Saisons, St. Hubert, QC J3Y 8P2';

// Icons
const facebookIcon = '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>';
const instagramIcon = '<rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>';
const linkedinIcon = '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>';
const mapPinIcon = '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>';
const phoneIcon = '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>';
const mailIcon = '<rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>';

const socialIcons = [
  { icon: facebookIcon, label: 'Facebook' },
  { icon: instagramIcon, label: 'Instagram' },
  { icon: linkedinIcon, label: 'LinkedIn' },
];
---

<footer class="bg-[var(--color-primary)] text-white">
  <!-- Top Wave (white coming from Contact section) - more pronounced -->
  <div class="relative">
    <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full block" preserveAspectRatio="none" style="height: 60px;">
      <path d="M0 0H1440V55C1440 55 1344 80 1248 95C1152 110 1056 115 960 105C864 95 768 75 672 65C576 55 480 60 384 80C288 100 192 115 96 110C48 107 0 95 0 95V0Z" fill="white"></path>
    </svg>
  </div>

  <!-- Main Footer -->
  <div class="container-tight py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Company Info -->
      <div class="lg:col-span-1">
        <div class="mb-6">
          <img 
            src="/assets/logo.png" 
            alt="GAMAS Janitorial Services" 
            class="h-16 w-auto object-contain"
          />
        </div>
        <p class="text-white/70 mb-6 leading-relaxed">
          Plus de 17 ans à offrir des services de nettoyage commercial d'excellence à Montréal et ses environs.
        </p>
        <div class="flex gap-4">
          {socialIcons.map((social) => (
            <a href="#" class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label={social.label}>
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={social.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-heading font-bold text-lg mb-6">Liens Rapides</h4>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/70 hover:text-white transition-colors inline-block">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Services -->
      <div>
        <h4 class="font-heading font-bold text-lg mb-6">Services</h4>
        <ul class="space-y-3">
          {services.map((service) => (
            <li class="text-white/70">{service}</li>
          ))}
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-heading font-bold text-lg mb-6">Contact</h4>
        <div class="space-y-4">

          <a href="tel:+15149784726" class="flex items-center gap-3 text-white/70 hover:text-white transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-brand-light" set:html={phoneIcon} />
            (514) 978-4726
          </a>
          <a href="mailto:irangamboa@servicemenagergamas.com" class="flex items-center gap-3 text-white/70 hover:text-white transition-colors">
  <svg 
    xmlns="http://www.w3.org/2000/svg"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-brand-light shrink-0"
    set:html={mailIcon}
  />
  irangamboa@servicemenagergamas.com
</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="container-tight py-6">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-white/60">
        <p>&copy; {currentYear} GAMAS. Tous droits réservés.</p>
        <div class="flex gap-6">
          <a href="#" class="hover:text-white transition-colors">Politique de Confidentialité</a>
          <a href="#" class="hover:text-white transition-colors">Conditions d'Utilisation</a>
        </div>
      </div>
    </div>
  </div>
</footer>
